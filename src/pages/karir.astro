---
import Layout from '../layouts/Layout.astro';
import AppNavigation from '../components/AppNavigation.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Karir & Lowongan Kerja - PT Cahaya Lintang Abadi"
  description="Bergabunglah dengan tim profesional PT Cahaya Lintang Abadi. Temukan kesempatan karir dan kembangkan potensi terbaik Anda bersama kami."
>
  <AppNavigation />

  <main class="bg-[#0a0a0a] min-h-screen pt-[120px] pb-24 text-white">
    <!-- Ambient Blur Background -->
    <div class="fixed top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-yellow-500/10 rounded-full blur-[140px] pointer-events-none z-0"></div>

    <div class="relative z-10 max-w-[1280px] mx-auto px-4 md:px-12">
      <!-- Header Hero -->
      <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-yellow-500/30 bg-neutral-900/80 backdrop-blur-md mb-6">
          <span class="w-2 h-2 rounded-full bg-yellow-500 animate-pulse"></span>
          <span class="font-mono text-xs text-yellow-400 font-semibold tracking-wider uppercase">CAREERS & OPPORTUNITIES</span>
        </div>
        <h1 class="font-syne font-bold text-3xl md:text-5xl text-neutral-50 mb-6 leading-tight">
          Mari Tumbuh & Berkarir Bersama <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600">PT Cahaya Lintang Abadi</span>
        </h1>
        <p class="font-sans text-neutral-400 text-sm md:text-base leading-relaxed">
          Kami selalu mencari talenta berdedikasi dan profesional untuk memperkuat layanan infrastruktur serta jaringan terbaik di Indonesia.
        </p>
      </div>

      <!-- Main Section: Grid Poster & Fast Submit -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-20">
        <!-- Left Column: Poster Lowongan (Visual Container) -->
        <div class="lg:col-span-6 bg-neutral-900 border border-white/10 rounded-2xl p-6 relative overflow-hidden shadow-2xl" data-aos="fade-right">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10">
            <span class="font-mono text-xs text-yellow-500 font-semibold">POSTER REKRUTMEN</span>
            <span class="text-xs bg-yellow-500/20 text-yellow-400 px-2.5 py-1 rounded border border-yellow-500/30 font-mono">STATUS: OPEN</span>
          </div>

          <!-- Poster Image / Card Container -->
          <div class="relative aspect-[3/4] w-full rounded-xl overflow-hidden bg-neutral-950 border border-white/5 flex flex-col items-center justify-center p-8 text-center group">
            <!-- Background Decorative Grid -->
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:24px_24px]"></div>

            <img
              src="/images/poster-lowongan-placeholder.webp"
              alt="Poster Rekrutmen PT Cahaya Lintang Abadi"
              class="absolute inset-0 w-full h-full object-cover"
              id="poster-img"
              onerror="this.style.display='none'; const fb = document.getElementById('poster-fallback'); if(fb) fb.style.display='flex';"
            />

            <!-- Fallback visual if image not present -->
            <div id="poster-fallback" class="relative z-10 flex flex-col items-center justify-center max-w-sm">
              <div class="w-16 h-16 rounded-full bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center text-yellow-400 text-2xl mb-4 group-hover:scale-110 transition-transform duration-300">
                <Icon icon="fa-solid fa-briefcase" />
              </div>
              <h3 class="font-syne text-xl font-bold text-white mb-2">Poster Lowongan Pekerjaan</h3>
              <p class="font-sans text-xs text-neutral-400 mb-6 leading-relaxed">
                Poster rekrutmen terbaru PT Cahaya Lintang Abadi akan ditampilkan di sini. Anda dapat langsung melamar posisi yang tersedia di samping.
              </p>
              <div class="inline-flex items-center gap-2 text-xs font-mono text-yellow-400 bg-yellow-500/10 px-3 py-1.5 rounded border border-yellow-500/20">
                <Icon icon="fa-solid fa-info-circle" /> PT CAHAYA LINTANG ABADI HIRING
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Qualification & Application Box -->
        <div class="lg:col-span-6 flex flex-col gap-6" data-aos="fade-left">
          <!-- Kualifikasi Umum Card -->
          <div class="bg-neutral-900 border border-white/10 rounded-2xl p-6 md:p-8">
            <h2 class="font-syne text-xl font-bold text-white mb-4 flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-yellow-500/20 border border-yellow-500/40 text-yellow-400 flex items-center justify-center text-sm">
                <Icon icon="fa-solid fa-user-check" />
              </span>
              Kualifikasi Umum
            </h2>
            <ul class="space-y-3 text-xs md:text-sm text-neutral-300">
              <li class="flex items-start gap-2.5">
                <Icon icon="fa-solid fa-circle-check" class="text-yellow-400 mt-1 flex-shrink-0" />
                <span>Pendidikan minimal SMA/SMK/D3/S1 sesuai posisi yang dilamar.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <Icon icon="fa-solid fa-circle-check" class="text-yellow-400 mt-1 flex-shrink-0" />
                <span>Jujur, disiplin, bertanggung jawab, dan memiliki integritas tinggi.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <Icon icon="fa-solid fa-circle-check" class="text-yellow-400 mt-1 flex-shrink-0" />
                <span>Mampu bekerja secara mandiri maupun di dalam tim.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <Icon icon="fa-solid fa-circle-check" class="text-yellow-400 mt-1 flex-shrink-0" />
                <span>Bersedia bekerja di area operasional PT Cahaya Lintang Abadi.</span>
              </li>
            </ul>
          </div>

          <!-- Berkas Kelengkapan Card -->
          <div class="bg-neutral-900 border border-white/10 rounded-2xl p-6 md:p-8">
            <h2 class="font-syne text-xl font-bold text-white mb-4 flex items-center gap-3">
              <span class="w-8 h-8 rounded-lg bg-yellow-500/20 border border-yellow-500/40 text-yellow-400 flex items-center justify-center text-sm">
                <Icon icon="fa-solid fa-file-invoice" />
              </span>
              Berkas Lamaran (PDF)
            </h2>
            <div class="grid grid-cols-2 gap-3 text-xs text-neutral-300 mb-6">
              <div class="p-3 bg-neutral-950 rounded-lg border border-white/5 flex items-center gap-2">
                <Icon icon="fa-solid fa-file-pdf" class="text-red-400" />
                <span>Curriculum Vitae (CV) Terbaru</span>
              </div>
              
    

            <!-- Direct Submit Email CTA Box -->
            <div class="p-5 bg-gradient-to-br from-neutral-950 to-neutral-900 border border-yellow-500/30 rounded-xl relative overflow-hidden">
              <div class="mb-4">
                <span class="text-xs text-yellow-400 font-mono font-semibold uppercase tracking-wider block mb-1">Kirim Lamaran Sekarang</span>
                <p class="text-xs text-neutral-400">
                  Kirimkan berkas lamaran Anda via email ke alamat resmi rekrutmen kami di bawah ini:
                </p>
              </div>

              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                <!-- Mailto Button -->
                <a
                  href="mailto:contact@cahayalintangabadi.com?subject=Lamaran%20Pekerjaan%20-%20[Nama%20Lengkap]"
                  class="flex-1 bg-yellow-500 hover:bg-yellow-400 text-neutral-950 font-bold text-xs md:text-sm py-3 px-5 rounded-lg flex items-center justify-center gap-2 transition-all duration-300 shadow-lg shadow-yellow-500/20"
                >
                  <Icon icon="fa-solid fa-paper-plane" />
                  Kirim CV Via Email
                </a>

                <!-- Copy Email Button -->
                <button
                  id="copy-email-btn"
                  data-email="contact@cahayalintangabadi.com"
                  class="bg-neutral-800 hover:bg-neutral-700 text-white font-semibold text-xs py-3 px-4 rounded-lg flex items-center justify-center gap-2 border border-white/10 transition-colors"
                  title="Salin Email"
                >
                  <Icon icon="fa-solid fa-copy" id="copy-icon" />
                  <span id="copy-text">Salin Email</span>
                </button>
              </div>

              <div class="mt-3 text-[11px] font-mono text-neutral-400 flex items-center gap-1.5">
                <Icon icon="fa-solid fa-envelope" class="text-yellow-500" />
                <span>contact@cahayalintangabadi.com</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step Recruitment Flow -->
      <div class="bg-neutral-900 border border-white/10 rounded-2xl p-8 md:p-12 mb-16" data-aos="fade-up">
        <div class="text-center max-w-xl mx-auto mb-12">
          <h2 class="font-syne text-2xl md:text-3xl font-bold text-white mb-3">Tahapan Rekrutmen</h2>
          <p class="text-xs md:text-sm text-neutral-400">Proses seleksi yang transparan dan profesional di PT Cahaya Lintang Abadi.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
          <!-- Step 1 -->
          <div class="bg-neutral-950 p-6 rounded-xl border border-white/5 relative">
            <span class="font-mono text-3xl font-bold text-yellow-500/40 block mb-3">01</span>
            <h3 class="font-syne text-sm font-bold text-white mb-1">Pengiriman Berkas</h3>
            <p class="text-xs text-neutral-400">Kirim CV & berkas lamaran lengkap Anda ke email resmi.</p>
          </div>

          <!-- Step 2 -->
          <div class="bg-neutral-950 p-6 rounded-xl border border-white/5 relative">
            <span class="font-mono text-3xl font-bold text-yellow-500/40 block mb-3">02</span>
            <h3 class="font-syne text-sm font-bold text-white mb-1">Seleksi Administrasi</h3>
            <p class="text-xs text-neutral-400">Tim HR akan meninjau kualifikasi dan berkas yang Anda kirimkan.</p>
          </div>

          <!-- Step 3 -->
          <div class="bg-neutral-950 p-6 rounded-xl border border-white/5 relative">
            <span class="font-mono text-3xl font-bold text-yellow-500/40 block mb-3">03</span>
            <h3 class="font-syne text-sm font-bold text-white mb-1">Wawancara & Tes</h3>
            <p class="text-xs text-neutral-400">Kandidat terpilih akan dihubungi untuk tahapan interview.</p>
          </div>

          <!-- Step 4 -->
          <div class="bg-neutral-950 p-6 rounded-xl border border-white/5 relative">
            <span class="font-mono text-3xl font-bold text-yellow-500/40 block mb-3">04</span>
            <h3 class="font-syne text-sm font-bold text-white mb-1">Onboarding</h3>
            <p class="text-xs text-neutral-400">Penerimaan resmi dan orientasi kerja bersama tim profesional.</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');
    const copyIcon = document.getElementById('copy-icon');

    copyBtn?.addEventListener('click', () => {
      const email = copyBtn.getAttribute('data-email') || 'contact@cahayalintangabadi.com';
      navigator.clipboard.writeText(email).then(() => {
        if (copyText) copyText.textContent = 'Tersalin!';
        if (copyIcon) copyIcon.className = 'fa-solid fa-check text-green-400';

        setTimeout(() => {
          if (copyText) copyText.textContent = 'Salin Email';
          if (copyIcon) copyIcon.className = 'fa-solid fa-copy';
        }, 2500);
      });
    });
  </script>
</Layout>
